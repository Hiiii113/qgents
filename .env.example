MYSQL_ROOT_PASSWORD=replace-with-long-random-value
DB_USERNAME=root
DB_PASSWORD=replace-with-long-random-value
REDIS_PASSWORD=replace-with-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
DASHSCOPE_API_KEY=
SMTP_USERNAME=replace-with-smtp-username
SMTP_AUTH_CODE=replace-with-smtp-auth-code
SANDBOX_DB_USERNAME=root
SANDBOX_DB_PASSWORD=replace-with-long-random-value
SANDBOX_BACKEND_SERVICE_TOKEN=replace-with-random-service-token
ATTACHMENT_SIGNING_SECRET=replace-with-random-secret
FRONTEND_URL=https://qgents.example.com
CORS_ALLOWED_ORIGINS=https://qgents.example.com
VITE_API_BASE_URL=https://api.example.com/api/v1
CLOUDFLARE_TUNNEL_TOKEN=
# Worker 子容器访问宿主 Docker 的组 ID：Linux 执行 `getent group docker | cut -d: -f3`
DOCKER_GID=999
# 必须是宿主机绝对路径，Worker 创建的子容器才能看到同一份 Workspace
QGENTS_DATA_ROOT=/srv/qgents
# Mihomo 配置由生产 Compose 的 mihomo_config 命名卷承载，不写入 .env 或 Git

# 团队 GitHub App；Agent 开启 GitHub 能力后使用该授权
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# 私钥 PEM 文件在 API 进程可访问的路径；容器部署时挂载到该路径
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CALLBACK_URL=
GITHUB_WEBHOOK_SECRET=

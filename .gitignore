# Target directory
target/
.m2/
.m2-local/
.m2-temp/
/data/

# Compiled class file
*.class

# Log file
*.log
logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# intelliJ IDEA
.idea/
*.iml

# VsCode
.vscode/

# ai files
.omc/
.claude/

# 其他文档默认忽略；产品愿景、接入说明和已确认需求规格纳入版本控制
/docs/*
!/docs/target.md
!/docs/github-app.md
!/docs/sandbox-tools.md
!/docs/specs/
/docs/specs/*
!/docs/specs/qgent-harness-refactor.md

# 环境变量文件（本地运行配置，一律不入库）
.env
.env.*

# RSA 私钥（只留后端，勿提交；公钥 public_key.pem 可提交）
src/main/resources/rsa/private_key.pem

# Private keys
*.pem

# 例外必须放在 *.pem 之后：git 以最后一条匹配规则为准
# 主后端 RSA 公钥公开无风险，允许提交
!src/main/resources/rsa/public_key.pem
# 环境变量配置示例允许提交
!.env.example

# 沙箱/工具临时目录
.codex-test-tmp/

# 脚本文件
scripts/

/secrets/

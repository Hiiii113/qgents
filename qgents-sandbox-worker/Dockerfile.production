FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
# 父 POM 与各模块 POM 都要参与，否则子模块无法解析 parent；只构建 qgents-sandbox-worker。
COPY pom.xml mvnw ./
COPY .mvn .mvn
COPY qgents-api/pom.xml qgents-api/pom.xml
COPY qgents-sandbox-worker/pom.xml qgents-sandbox-worker/pom.xml
COPY qgents-sandbox-worker/src qgents-sandbox-worker/src
RUN chmod +x mvnw && ./mvnw -pl qgents-sandbox-worker -DskipTests package

FROM eclipse-temurin:21-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home worker
WORKDIR /app
COPY --from=build /build/qgents-sandbox-worker/target/qgents-sandbox-worker-0.0.1-SNAPSHOT.jar app.jar
RUN mkdir -p /var/lib/qgents/git-store /var/lib/qgents/workspaces /var/lib/qgents/workspace-metadata /app/logs \
    && chown -R worker:worker /var/lib/qgents /app
USER 10001
EXPOSE 8091
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

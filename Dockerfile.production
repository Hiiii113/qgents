FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
# 父 POM 与各模块 POM 都要参与，否则子模块无法解析 parent；只构建 qgents-api，不编译 worker。
COPY pom.xml mvnw ./
COPY .mvn .mvn
COPY qgents-api/pom.xml qgents-api/pom.xml
COPY qgents-sandbox-worker/pom.xml qgents-sandbox-worker/pom.xml
COPY qgents-api/src qgents-api/src
RUN chmod +x mvnw && ./mvnw -pl qgents-api -DskipTests package

FROM eclipse-temurin:21-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home qgents
WORKDIR /app
COPY --from=build /build/qgents-api/target/qgents-api-0.0.1-SNAPSHOT.jar app.jar
RUN mkdir -p /app/logs /app/data && chown -R qgents:qgents /app
USER 10001
EXPOSE 8080 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
